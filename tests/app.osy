// The producer's test project for Osysharp.Guardianship — a music school: parents add their children, invite the other
// parent, answer the school's consent forms and keep the emergency contacts; teachers read them on the day; the office
// corrects links. The school writes its own rule on the kit's policy: a parent reads their child's lesson notes.
app GuardianshipKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Guardianship@0;
  use Osysharp.Ui;
  use Osysharp.Workflow;
  use Osysharp.Oauth;
}
